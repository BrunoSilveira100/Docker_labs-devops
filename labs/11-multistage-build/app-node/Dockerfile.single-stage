# Versão INGÊNUA (single-stage), mantida ruim DE PROPÓSITO para a comparação de tamanho.
# (Bruno Silveira: a única alteração aqui foi a ENV IMAGEM_VARIANTE, para a API dizer qual imagem respondeu.)
# Problema: a imagem final carrega o TypeScript, o código-fonte .ts e a
# imagem completa do node:20 (não a alpine), mesmo eles não sendo
# necessários para RODAR a aplicação já compilada.
FROM node:20

WORKDIR /app
COPY package.json ./
RUN npm install
COPY tsconfig.json ./
COPY src ./src
RUN npm run build

ENV IMAGEM_VARIANTE=single-stage
EXPOSE 5000
CMD ["npm", "start"]
