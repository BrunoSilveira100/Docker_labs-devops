# Modelo de variáveis — Bruno Silveira · Unifeg 2026B
# Copie para .env (ignorado pelo git) e TROQUE as senhas antes do primeiro 'up'.
# Atenção: o Postgres grava a senha no volume na 1a inicialização; trocar depois exige 'down -v'.
POSTGRES_USER=unifeg
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=lab_sistemas_distribuidos

PGADMIN_DEFAULT_EMAIL=bruno.silveira@unifeg.example.com
PGADMIN_DEFAULT_PASSWORD=troque-esta-senha-tambem
